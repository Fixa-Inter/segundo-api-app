### Autenticação
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "usuario13@plataforma.com",
  "senha": "Senha123"
}

> {% client.global.set("auth_token", response.body.token) %}

### Perfil
GET http://localhost:8080/api/v1/solicitacoes?
Authorization: Bearer {{auth_token}}

### Categorias de equipamento
GET http://localhost:8080/api/v1/equipamentos/categorias
Authorization: Bearer {{auth_token}}

### Categoria por ID
GET http://localhost:8080/api/v1/equipamentos/categorias/12
Authorization: Bearer {{auth_token}}

### Criar categoria
POST http://localhost:8080/api/v1/equipamentos/categorias
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{"nome":"Categoria teste","descricao":"Categoria criada pelo teste"}

### Atualizar categoria
PATCH http://localhost:8080/api/v1/equipamentos/categorias
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{"id":{{categoria_id}},"nome":"Categoria atualizada","descricao":"Descrição atualizada","estaAtivo":true}

### Marcas
GET http://localhost:8080/api/v1/equipamentos/marcas
Authorization: Bearer {{auth_token}}

###

GET http://localhost:8080/api/v1/equipamentos/marcas/3
Authorization: Bearer {{auth_token}}

### Modelos
GET http://localhost:8080/api/v1/equipamentos/modelos
Authorization: Bearer {{auth_token}}

###

GET http://localhost:8080/api/v1/equipamentos/modelos/{{modelo_id}}
Authorization: Bearer {{auth_token}}

### Equipamentos
GET http://localhost:8080/api/v1/equipamentos/modelo/{{modelo_id}}?codigo=teste&local_endereco=teste&usuario=teste
Authorization: Bearer {{auth_token}}

GET http://localhost:8080/api/v1/equipamentos/{{equipamento_id}}
Authorization: Bearer {{auth_token}}

### Eventos com período
GET http://localhost:8080/api/v1/eventos?data_hora_inicio=2026-01-01T00:00:00&data_hora_fim=2026-12-31T23:59:59&limite=20
Authorization: Bearer {{auth_token}}

GET http://localhost:8080/api/v1/eventos/{{evento_id}}
Authorization: Bearer {{auth_token}}

### Ocorrências com período de criação
GET http://localhost:8080/api/v1/ocorrencias?data_criacao_min=2026-01-01T00:00:00&data_criacao_max=2026-12-31T23:59:59&limite=20
Authorization: Bearer {{auth_token}}

GET http://localhost:8080/api/v1/ocorrencias/minhas?data_criacao_min=2026-01-01T00:00:00&data_criacao_max=2026-12-31T23:59:59
Authorization: Bearer {{auth_token}}

GET http://localhost:8080/api/v1/ocorrencias/{{ocorrencia_id}}
Authorization: Bearer {{auth_token}}

### Problemas com período de criação
GET http://localhost:8080/api/v1/solicitacoes?data_criacao_min=2026-01-01T00:00:00&data_criacao_max=2026-12-31T23:59:59&limite=20
Authorization: Bearer {{auth_token}}

GET http://localhost:8080/api/v1/solicitacoes/minhas?data_criacao_min=2026-01-01T00:00:00&data_criacao_max=2026-12-31T23:59:59
Authorization: Bearer {{auth_token}}

GET http://localhost:8080/api/v1/solicitacoes/selecionar/{{problema_id}}
Authorization: Bearer {{auth_token}}

### Ordens de serviço com período previsto
GET http://localhost:8080/api/v1/os?data_prevista_min=2026-01-01T00:00:00&data_prevista_max=2026-12-31T23:59:59&limite=20
Authorization: Bearer {{auth_token}}

GET http://localhost:8080/api/v1/os/minhas?data_prevista_min=2026-01-01T00:00:00&data_prevista_max=2026-12-31T23:59:59
Authorization: Bearer {{auth_token}}

GET http://localhost:8080/api/v1/os/{{ordem_servico_id}}
Authorization: Bearer {{auth_token}}

### Tarefas
GET http://localhost:8080/api/v1/tarefas/{{ordem_servico_id}}?titulo_tarefa=teste&titulo_ordem_servico=teste&usuario_responsavel=teste
Authorization: Bearer {{auth_token}}

GET http://localhost:8080/api/v1/tarefas/selecionar/{{tarefa_id}}
Authorization: Bearer {{auth_token}}

### Técnicos
GET http://localhost:8080/api/v1/tecnicos?nome_completo=teste&email=teste&cargo=teste&esta_ativo=true
Authorization: Bearer {{auth_token}}

GET http://localhost:8080/api/v1/tecnicos/competencias/{{tecnico_id}}
Authorization: Bearer {{auth_token}}

GET http://localhost:8080/api/v1/tecnicos/os/{{tecnico_id}}
Authorization: Bearer {{auth_token}}

### Exclusões disponíveis ao gestor
DELETE http://localhost:8080/api/v1/equipamentos/categorias/{{categoria_id}}
Authorization: Bearer {{auth_token}}

DELETE http://localhost:8080/api/v1/equipamentos/marcas/{{marca_id}}
Authorization: Bearer {{auth_token}}

DELETE http://localhost:8080/api/v1/equipamentos/modelos/{{modelo_id}}
Authorization: Bearer {{auth_token}}

DELETE http://localhost:8080/api/v1/equipamentos/{{equipamento_id}}
Authorization: Bearer {{auth_token}}

DELETE http://localhost:8080/api/v1/eventos/{{evento_id}}
Authorization: Bearer {{auth_token}}

DELETE http://localhost:8080/api/v1/ocorrencias/{{ocorrencia_id}}
Authorization: Bearer {{auth_token}}

DELETE http://localhost:8080/api/v1/os/{{ordem_servico_id}}
Authorization: Bearer {{auth_token}}

DELETE http://localhost:8080/api/v1/tarefas/{{tarefa_id}}
Authorization: Bearer {{auth_token}}
